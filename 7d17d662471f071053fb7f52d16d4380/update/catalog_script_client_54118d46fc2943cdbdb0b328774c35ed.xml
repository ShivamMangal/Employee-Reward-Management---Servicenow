        <name>Auto-populate Department on Employee Cha</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) return;

    if (!newValue) {
        g_form.clearValue('department');
        return;
    }

    // Look up the selected employee's department and set it
    g_form.getReference('employee', function (ref) {
        if (ref && ref.department) {
            g_form.setValue('department', ref.department);
        } else {
            g_form.clearValue('department');
        }
    });
}
]]></script>
